# Build artifacts
build/
*.o
# Auto-generated header dependencies (-MMD -MP)
*.d
# Main binary (anchored: only the repo-root binary, not anything
# named `minicontainer` inside a subdirectory).
/minicontainer
# Compiled test binaries at the repo root.  Anchored with a leading
# slash so the pattern does NOT match source files under tests/
# (which would silently hide test_*.c from `git add`).  Covers
# test_core, test_mount, test_overlay, test_uts, test_cgroup,
# test_net, test_state, test_bind, test_cli, and any future test
# binary that lands here.
/test_*

# Generated rootfs (built from host binaries, not source)
rootfs/
ubuntu-root/

# Runtime container state (created by --overlay; per-container subdirs of
# upper/work/merged). Phase 3+ writes here. Default location set in main.c;
# overridable via --container-dir.
containers/

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Debug and profiling
*.dSYM/
*.su
*.out
vgcore.*
core

# Temporary files
*.tmp
*.log